#: dashboard/api_v2.py:609 dashboard/api_v2.py:654 dashboard/api_v2.py:688
msgid "An area with this name already exists."
msgstr "Já existe uma área com este nome."

#: dashboard/api_v2.py:723
msgid "The area cannot be deleted because it has alerts associated with it."
msgstr "A área não pode ser eliminada porque tem alertas associados."

#: dashboard/api_v2.py:1365
msgid "At least one species must be selected"
msgstr "Tem de selecionar pelo menos uma espécie"

#: dashboard/api_v2.py:1370
msgid "At least one area must be selected for the chosen area filter mode."
msgstr ""
"Tem de selecionar pelo menos uma área para o modo de filtro de área escolhido."

#: dashboard/api_v2.py:1390
msgid "One or more selected areas do not exist or are not available to you."
msgstr ""
"Uma ou mais das áreas selecionadas não existem ou não estão disponíveis para "
"si."

#: dashboard/api_v2.py:1597
msgid ""
"A template can only reference public areas; this alert uses a private one."
msgstr ""
"Um modelo só pode referir áreas públicas; este alerta utiliza uma área "
"privada."

#: dashboard/api_v2.py:1621
msgid "Invalid username or password."
msgstr "Nome de utilizador ou palavra-passe inválidos."

#: dashboard/api_v2.py:1683
msgid "The old password is incorrect."
msgstr "A palavra-passe antiga está incorreta."

#: dashboard/api_v2.py:1691
msgid "The two passwords do not match."
msgstr "As duas palavras-passe não coincidem."

#: dashboard/api_v2.py:1765
msgid "This email address is already in use."
msgstr "Este endereço de e-mail já está a ser utilizado."

#: dashboard/forms.py:26
msgid "First name"
msgstr "Nome próprio"

#: dashboard/forms.py:26 dashboard/forms.py:29
msgid "Optional."
msgstr "Opcional."

#: dashboard/forms.py:29
msgid "Last name"
msgstr "Apelido"

#: dashboard/forms.py:32
msgid "Email"
msgstr "E-mail"

#: dashboard/forms.py:34
msgid "Required. Enter a valid email address."
msgstr "Obrigatório. Introduza um endereço de e-mail válido."

#: dashboard/forms.py:38
msgid "Language"
msgstr "Idioma"

#: dashboard/forms.py:40
msgid "This language will be used for emails."
msgstr "Este idioma será utilizado nos e-mails."

#: dashboard/models.py:1296
msgid "species"
msgstr "espécies"

#: dashboard/models.py:1299
msgid ""
"To select multiple items, press and hold the Ctrl or Command key and click "
"the items."
msgstr ""
"Para selecionar vários itens, mantenha premida a tecla Ctrl ou Command e "
"clique nos itens."

#: dashboard/models.py:1305
msgid "datasets"
msgstr "conjuntos de dados"

#: dashboard/models.py:1308
msgid ""
"Optional (no selection = notify me for all datasets). To select multiple "
"items, press and hold the Ctrl or Command key and click the items."
msgstr ""
"Opcional (sem seleção = notificar-me para todos os conjuntos de dados). Para "
"selecionar vários itens, mantenha premida a tecla Ctrl ou Command e clique "
"nos itens."

#: dashboard/models.py:1314
msgid "basis of record"
msgstr "base do registo"

#: dashboard/models.py:1317
msgid ""
"Optional (no selection = notify me for all basis of records). To select "
"multiple items, press and hold the Ctrl or Command key and click the items."
msgstr ""
"Opcional (sem seleção = notificar-me para todas as bases do registo). Para "
"selecionar vários itens, mantenha premida a tecla Ctrl ou Command e clique "
"nos itens."

#: dashboard/models.py:1324
msgid "areas"
msgstr "áreas"

#: dashboard/models.py:1326
msgid ""
"Optional (no selection = notify me for all data in the system). To select "
"multiple items, press and hold the Ctrl or Command key and click the items."
msgstr ""
"Opcional (sem seleção = notificar-me para todos os dados do sistema). Para "
"selecionar vários itens, mantenha premida a tecla Ctrl ou Command e clique "
"nos itens."

