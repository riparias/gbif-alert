#: dashboard/templates/dashboard/password_reset.html:8
#: dashboard/templates/dashboard/password_reset.html:14
msgid "Forgot your password?"
msgstr "Esqueceu-se da palavra-passe?"

#: dashboard/templates/dashboard/password_reset.html:15
msgid ""
"Enter your email address below, and we'll email instructions for setting a "
"new one."
msgstr ""
"Introduza o seu endereço de e-mail abaixo e enviar-lhe-emos por e-mail as "
"instruções para definir uma nova."

#: dashboard/templates/dashboard/password_reset.html:21
msgid "Send me instructions!"
msgstr "Enviem-me as instruções!"

#: dashboard/templates/dashboard/password_reset_complete.html:7
#: dashboard/templates/dashboard/password_reset_complete.html:13
msgid "Password reset complete"
msgstr "Redefinição da palavra-passe concluída"

#: dashboard/templates/dashboard/password_reset_complete.html:16
#, python-format
msgid ""
"\n"
"                Your new password has been set. You can now <a "
"href=\"%(signin_url)s\">sign in</a>.\n"
"            "
msgstr ""
"\n"
"A sua nova palavra-passe foi definida. Já pode <a "
"href=\"%(signin_url)s\">iniciar sessão</a>."

#: dashboard/templates/dashboard/password_reset_confirm.html:8
msgid "Reset your password"
msgstr "Redefinir a palavra-passe"

#: dashboard/templates/dashboard/password_reset_confirm.html:15
msgid "Set a new password!"
msgstr "Defina uma nova palavra-passe!"

#: dashboard/templates/dashboard/password_reset_confirm.html:20
msgid "Change my password"
msgstr "Alterar a minha palavra-passe"

#: dashboard/templates/dashboard/password_reset_confirm.html:25
msgid ""
"The password reset link was invalid, possibly because it has already been "
"used. Please request a new password reset."
msgstr ""
"A ligação de redefinição da palavra-passe é inválida, possivelmente porque já "
"foi utilizada. Peça uma nova redefinição da palavra-passe."

#: dashboard/templates/dashboard/password_reset_done.html:8
msgid "Instructions sent"
msgstr "Instruções enviadas"

#: dashboard/templates/dashboard/password_reset_done.html:14
msgid "Check your inbox."
msgstr "Verifique a sua caixa de entrada."

#: dashboard/templates/dashboard/password_reset_done.html:16
msgid ""
"We've emailed you instructions for setting your password. You should receive "
"the email shortly!"
msgstr ""
"Enviámos-lhe por e-mail as instruções para definir a sua palavra-passe. "
"Deverá recebê-lo em breve!"
