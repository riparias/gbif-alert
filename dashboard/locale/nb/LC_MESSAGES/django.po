#: dashboard/api_v2.py:546 dashboard/api_v2.py:591 dashboard/api_v2.py:624
msgid "An area with this name already exists."
msgstr "Det finnes allerede et område med dette navnet."

#: dashboard/api_v2.py:656
msgid "The area cannot be deleted because it has alerts associated with it."
msgstr "Området kan ikke slettes fordi det er knyttet varsler til det."

#: dashboard/api_v2.py:1164
msgid "At least one species must be selected"
msgstr "Minst én art må velges"

#: dashboard/api_v2.py:1169
msgid "At least one area must be selected for the chosen area filter mode."
msgstr "Minst ett område må velges for den valgte områdefiltermodusen."

#: dashboard/api_v2.py:1372
msgid "Invalid username or password."
msgstr "Ugyldig brukernavn eller passord."

#: dashboard/api_v2.py:1431
msgid "The old password is incorrect."
msgstr "Det gamle passordet er feil."

#: dashboard/api_v2.py:1436
msgid "The two passwords do not match."
msgstr "De to passordene er ikke like."

#: dashboard/api_v2.py:1507
msgid "This email address is already in use."
msgstr "Denne e-postadressen er allerede i bruk."

#: dashboard/forms.py:26
msgid "First name"
msgstr "Fornavn"

#: dashboard/forms.py:26 dashboard/forms.py:29
msgid "Optional."
msgstr "Valgfritt."

#: dashboard/forms.py:29
msgid "Last name"
msgstr "Etternavn"

#: dashboard/forms.py:32
msgid "Email"
msgstr "E-post"

#: dashboard/forms.py:34
msgid "Required. Enter a valid email address."
msgstr "Påkrevd. Oppgi en gyldig e-postadresse."

#: dashboard/forms.py:38
msgid "Language"
msgstr "Språk"

#: dashboard/forms.py:40
msgid "This language will be used for emails."
msgstr "Dette språket brukes i e-poster."

#: dashboard/models.py:1289
msgid "species"
msgstr "arter"

#: dashboard/models.py:1292
msgid ""
"To select multiple items, press and hold the Ctrl or Command key and click "
"the items."
msgstr ""
"For å velge flere elementer, hold inne Ctrl- eller Command-tasten og klikk "
"på elementene."

#: dashboard/models.py:1298
msgid "datasets"
msgstr "datasett"

#: dashboard/models.py:1301
msgid ""
"Optional (no selection = notify me for all datasets). To select multiple "
"items, press and hold the Ctrl or Command key and click the items."
msgstr ""
"Valgfritt (ingen valg = varsle meg om alle datasett). For å velge flere "
"elementer, hold inne Ctrl- eller Command-tasten og klikk på elementene."

#: dashboard/models.py:1307
msgid "basis of record"
msgstr "registreringsgrunnlag"

#: dashboard/models.py:1310
msgid ""
"Optional (no selection = notify me for all basis of records). To select "
"multiple items, press and hold the Ctrl or Command key and click the items."
msgstr ""
"Valgfritt (ingen valg = varsle meg om alle registreringsgrunnlag). For å "
"velge flere elementer, hold inne Ctrl- eller Command-tasten og klikk på "
"elementene."

#: dashboard/models.py:1317
msgid "areas"
msgstr "områder"

#: dashboard/models.py:1319
msgid ""
"Optional (no selection = notify me for all data in the system). To select "
"multiple items, press and hold the Ctrl or Command key and click the items."
msgstr ""
"Valgfritt (ingen valg = varsle meg om alle data i systemet). For å velge "
"flere elementer, hold inne Ctrl- eller Command-tasten og klikk på elementene."

#: dashboard/models.py:1456
msgid "No emails"
msgstr "Ingen e-poster"

#: dashboard/models.py:1457
msgid "Daily"
msgstr "Daglig"

#: dashboard/models.py:1458
msgid "Weekly"
msgstr "Ukentlig"

#: dashboard/models.py:1459
msgid "Monthly"
msgstr "Månedlig"

#: dashboard/models.py:1470
msgid "name"
msgstr "navn"

#: dashboard/models.py:1477
msgid "email notifications frequency"
msgstr "frekvens for e-postvarsler"

#: dashboard/models.py:1644
msgid "new observation(s) for your alert"
msgstr "nye observasjoner for varselet ditt"

#: dashboard/templates/dashboard/_eu_funding_acknowledgement.html:20
msgid "Funded by the European Union"
msgstr "Finansiert av Den europeiske union"

#: dashboard/templates/dashboard/_footer.html:10
msgid "API"
msgstr "API"

#: dashboard/templates/dashboard/_footer.html:11
msgid "Latest data import:"
msgstr "Siste dataimport:"

#: dashboard/templates/dashboard/_footer.html:12
msgid ""
"This site is powered by <a href=\"https://github.com/riparias/gbif-"
"alert\">GBIF Alert</a> version"
msgstr ""
"Dette nettstedet drives av <a href=\"https://github.com/riparias/gbif-"
"alert\">GBIF Alert</a> versjon"

#: dashboard/templates/dashboard/password_reset.html:8
#: dashboard/templates/dashboard/password_reset.html:14
msgid "Forgot your password?"
msgstr "Glemt passordet?"

#: dashboard/templates/dashboard/password_reset.html:15
msgid ""
"Enter your email address below, and we'll email instructions for setting a "
"new one."
msgstr ""
"Skriv inn e-postadressen din nedenfor, så sender vi deg instruksjoner for å "
"opprette et nytt."

#: dashboard/templates/dashboard/password_reset.html:21
msgid "Send me instructions!"
msgstr "Send meg instruksjoner!"

#: dashboard/templates/dashboard/password_reset_complete.html:7
#: dashboard/templates/dashboard/password_reset_complete.html:13
msgid "Password reset complete"
msgstr "Passordet er tilbakestilt"

#: dashboard/templates/dashboard/password_reset_complete.html:16
#, python-format
msgid ""
"\n"
"                Your new password has been set. You can now <a "
"href=\"%(signin_url)s\">sign in</a>.\n"
"            "
msgstr ""
"\n"
"                Det nye passordet ditt er lagret. Du kan nå <a "
"href=\"%(signin_url)s\">logge inn</a>.\n"
"            "

#: dashboard/templates/dashboard/password_reset_confirm.html:8
msgid "Reset your password"
msgstr "Tilbakestill passordet ditt"

#: dashboard/templates/dashboard/password_reset_confirm.html:15
msgid "Set a new password!"
msgstr "Velg et nytt passord!"

#: dashboard/templates/dashboard/password_reset_confirm.html:20
msgid "Change my password"
msgstr "Endre passordet mitt"

#: dashboard/templates/dashboard/password_reset_confirm.html:25
msgid ""
"The password reset link was invalid, possibly because it has already been "
"used. Please request a new password reset."
msgstr ""
"Lenken for tilbakestilling av passord var ugyldig, kanskje fordi den "
"allerede er brukt. Be om en ny tilbakestilling av passordet."

#: dashboard/templates/dashboard/password_reset_done.html:8
msgid "Instructions sent"
msgstr "Instruksjoner sendt"

#: dashboard/templates/dashboard/password_reset_done.html:14
msgid "Check your inbox."
msgstr "Sjekk innboksen din."

#: dashboard/templates/dashboard/password_reset_done.html:16
msgid ""
"We've emailed you instructions for setting your password. You should receive "
"the email shortly!"
msgstr ""
"Vi har sendt deg instruksjoner for å angi passordet ditt på e-post. Du skal "
"motta e-posten om kort tid!"
